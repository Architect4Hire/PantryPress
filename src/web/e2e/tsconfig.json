/* Type-checks the Playwright runs and their config (PP3.6): `npx tsc -p e2e`. Playwright compiles them itself. */
{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
