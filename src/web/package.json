{
  "name": "pantrypress-web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start:admin": "ng serve pantrypress-admin",
    "start:site": "ng serve pantrypress-site",
    "build": "ng build pantrypress-ui && ng build pantrypress-admin && ng build pantrypress-site",
    "build:site": "ng build pantrypress-site",
    "serve:ssr:pantrypress-site": "node dist/pantrypress-site/server/server.mjs",
    "lint": "ng lint",
    "test": "ng test pantrypress-ui --watch=false && ng test pantrypress-admin --watch=false && ng test pantrypress-site --watch=false",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.4",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
