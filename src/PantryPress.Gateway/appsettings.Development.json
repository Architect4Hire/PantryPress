{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gateway": {
    "Hosts": [ "localhost" ],
    "AdminApp": {
      "Root": ""
    }
  },
  "ReverseProxy": {
    "Routes": {
      "admin-spa": {
        "ClusterId": "admin",
        "Order": 1000,
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "admin": {
        "Destinations": {
          "dev-server": {
            "Address": "http://admin"
          }
        }
      }
    }
  }
}
