{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "SessionPerIpPerMinute": 20,
    "Hosts": [ "pantrypress.app" ],
    "AdminApp": {
      "Root": "admin",
      "PublicPaths": [ "/", "/pricing", "/terms", "/privacy", "/acceptable-use", "/dmca" ],
      "SignedInRedirectPaths": [ "/", "/pricing" ],
      "SignedInHome": "/dashboard"
    }
  },
  "Edge": {
    "TrustedProxies": {
      "ForwardLimit": 1,
      "KnownProxies": [],
      "KnownNetworks": []
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api-v1": {
        "ClusterId": "api",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/{**rest}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "apiservice": {
            "Address": "http://apiservice"
          }
        }
      }
    }
  }
}
