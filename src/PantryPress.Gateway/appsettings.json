{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-v1": {
        "ClusterId": "api",
        "Order": 1,
        "Match": {
          "Path": "/api/v1/{**rest}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "apiservice": {
            "Address": "http://apiservice"
          }
        }
      }
    }
  }
}
