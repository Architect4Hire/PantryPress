{"@context":"https://schema.org","@type":"Recipe","@id":"https://apple-pie.pantrypress.app/deep-dish-apple-pie#recipe","name":"Deep-dish apple pie","description":"A tall, flaky pie with a spiced apple filling.","image":["https://apple-pie.pantrypress.app/media/pie-1x1-3f9a2c.jpg","https://apple-pie.pantrypress.app/media/pie-4x3-3f9a2c.jpg","https://apple-pie.pantrypress.app/media/pie-16x9-3f9a2c.jpg"],"author":{"@type":"Person","name":"Maya Brooks"},"datePublished":"2026-10-01","prepTime":"PT45M","cookTime":"PT1H15M","totalTime":"PT5H","recipeYield":"6\u20138 servings","recipeCategory":"Dessert","recipeCuisine":"American","keywords":"fall baking, Thanksgiving","suitableForDiet":["https://schema.org/VegetarianDiet"],"tool":["9-inch deep-dish pie plate","Pastry blender"],"recipeIngredient":["2\u00BD cups all-purpose flour","1 teaspoon salt","1 cup cold unsalted butter, cubed","3 pounds apples, peeled and sliced","\u00BE cup sugar","2 tablespoons lemon juice"],"recipeInstructions":[{"@type":"HowToSection","name":"Make the crust","itemListElement":[{"@type":"HowToStep","text":"Whisk the flour and salt, then cut in the butter."},{"@type":"HowToStep","text":"Chill the dough for 1 hour."}]},{"@type":"HowToSection","name":"Fill and bake","itemListElement":[{"@type":"HowToStep","text":"Toss the apples with the sugar and lemon juice."},{"@type":"HowToStep","text":"Bake at 375\u00B0F for 75 minutes."}]}],"nutrition":{"@type":"NutritionInformation","servingSize":"1 slice","calories":"410.5 calories","fatContent":"19.25 g","saturatedFatContent":"11 g","sodiumContent":"230 mg","carbohydrateContent":"58 g","fiberContent":"3 g","sugarContent":"29 g","proteinContent":"4.5 g"}}
